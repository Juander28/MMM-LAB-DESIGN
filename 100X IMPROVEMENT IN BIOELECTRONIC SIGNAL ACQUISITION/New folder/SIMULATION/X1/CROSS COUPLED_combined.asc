TEXT -1104 -1200 Left 2 ;Cross-Coupled Negative-gm Q-Enhanced LC Resonator
TEXT -1104 -1168 Left 2 ;UCLA/UCI Resonant Electrophysiology - Topology A.1
TEXT -1096 -1128 Left 2 ;Single channel, scalable 50-200 MHz, EMG-modulated varactor
TEXT -1104 -1072 Left 2 !.param VDD=1.5 L=100n alpha=0.5 RS=0.4
TEXT -1104 -1024 Left 2 !.param Cc=5f Rb=100k VBIAS_V=0.6
TEXT -1104 -984 Left 2 !.param EMGamp=5m EMGfreq=100
TEXT -1104 -936 Left 2 !.model NMOSGEN NMOS (Vto=0.3 Kp=700u Lambda=0.02 Cgso=0.2f Cgdo=0.2f Cgbo=0.1f)
TEXT -1112 -888 Left 2 !.step param Itail 900u 1m 25u
TEXT -1104 -816 Left 2 ;Probe: V(D1)-V(D2) for differential output
TEXT -1112 -784 Left 2 ;Cross-coupling done by FLAG labels (M1.gate=D2, M2.gate=D1)
TEXT -1104 -744 Left 2 ;Tip: if any pin shows red dot in LTspice, drag a short wire from pin to nearest FLAG.
TEXT -1112 -856 Left 2 !.ac lin 20000 49Meg 60Meg
TEXT -1104 -712 Left 2 !.step param cp 0.1p 3.2p 1p
TEXT -1104 -1480 Left 2 !.meas AC fpeak FIND frequency WHEN V(D1,D2)=MAX\n.meas AC vmax MAX mag(V(D1,D2))\n.meas AC f1 WHEN mag(V(D1,D2))=vmax/sqrt(2) CROSS=1\n.meas AC f2 WHEN mag(V(D1,D2))=vmax/sqrt(2) CROSS=2\n.meas AC BW3dB PARAM f2-f1\n.meas AC Qfactor PARAM fpeak/BW3dB
TEXT -1104 -680 Left 2 !.param C=101.32p
TEXT -1104 -656 Left 2 !.param C1=90p
