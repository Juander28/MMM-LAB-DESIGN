TEXT -1104 -1480 Left 2 !.meas AC vbaseA FIND mag(V(act+,act-)) AT 55.45Meg\n.meas AC vminA MIN mag(V(act+,act-)) FROM 55.7Meg TO 56.1Meg\n.meas AC depthA PARAM 20*log10(vbaseA/vminA)\n.meas AC fA1 WHEN mag(V(act+,act-))=vbaseA/sqrt(2) FROM 55.7Meg TO 56.1Meg CROSS=1\n.meas AC fA2 WHEN mag(V(act+,act-))=vbaseA/sqrt(2) FROM 55.7Meg TO 56.1Meg CROSS=2\n.meas AC BWA PARAM fA2-fA1\n.meas AC QA PARAM 0.5*(fA1+fA2)/BWA\n.meas AC vbaseB FIND mag(V(act+,act-)) AT 99.65Meg\n.meas AC vminB MIN mag(V(act+,act-)) FROM 99.85Meg TO 100.15Meg\n.meas AC depthB PARAM 20*log10(vbaseB/vminB)\n.meas AC fB1 WHEN mag(V(act+,act-))=vbaseB/sqrt(2) FROM 99.85Meg TO 100.15Meg CROSS=1\n.meas AC fB2 WHEN mag(V(act+,act-))=vbaseB/sqrt(2) FROM 99.85Meg TO 100.15Meg CROSS=2\n.meas AC BWB PARAM fB2-fB1\n.meas AC QB PARAM 0.5*(fB1+fB2)/BWB
TEXT -1112 -792 Left 2 !.param c=101p
